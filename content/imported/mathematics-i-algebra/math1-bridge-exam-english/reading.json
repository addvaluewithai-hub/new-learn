  "scenes": [
    {
      "id": "S01",
      "title": "شرح 1: عشرين كلمة بس",
      "clipId": "N01",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S01",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-exam-english"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S01-U01"
          ],
          "text": "الامتحان بالإنجليزي، بس مش محتاج إنجليزي قوي: سؤال الرياضة بيتبني من حوالي 20 كلمة بتتكرر.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U02"
          ],
          "text": "العمليات: $+$ plus، $−$ minus، $×$ times، $=$ equals.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U03"
          ],
          "text": "وفي الكسور: over يعني «على»: $5/6$ = five over six.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U04"
          ],
          "text": "$(x + 1)/(x − 2)$ = x plus one over x minus two. اللي قبل over فوق الخط، واللي بعدها تحته.",
          "written": true
        }
      ]
    },
    {
      "id": "S02",
      "title": "شرح 2: الأسس وأجزاء الكسر",
      "clipId": "N02",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S02",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-exam-english"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S02-U01"
          ],
          "text": "$x²$ = x squared، $x³$ = x cubed، $x⁴$ = x to the power four.",
          "written": true
        },
        {
          "unitIds": [
            "S02-U02"
          ],
          "text": "$2x²$ = two x squared.",
          "written": true
        },
        {
          "unitIds": [
            "S02-U03"
          ],
          "text": "البسط numerator والمقام denominator.",
          "written": true
        },
        {
          "unitIds": [
            "S02-U04"
          ],
          "text": "factor = عامل، factorise = حلّل، expand = افرد الأقواس، degree = الدرجة (أعلى أس).",
          "written": true
        }
      ]
    },
    {
      "id": "S03",
      "title": "شرح 3: أفعال الطلب والشروط",
      "clipId": "N03",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S03",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-exam-english"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S03-U01"
          ],
          "text": "أفعال الطلب بتقولك تعمل إيه: Find = أوجد، Solve = حل، Simplify = بسّط.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U02"
          ],
          "text": "Verify = اتأكد إنه صح، Express أو Resolve = اكتبه في صورة تانية، State = اذكر الإجابة.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U03"
          ],
          "text": "الشروط: not equal to = لا يساوي ($≠$). for $x ≠ 1$ = بشرط $x$ ما تساويش 1.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U04"
          ],
          "text": "excluded values = القيم الممنوعة اللي بتخلي المقام صفر.",
          "written": true
        }
      ]
    },
    {
      "id": "S04",
      "title": "شرح 4: نقرا سؤال كامل",
      "clipId": "N04",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S04",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-exam-english"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S04-U01"
          ],
          "text": "سؤال كامل: Resolve $(x + 1)/(x² − 3x + 2)$ into partial fractions.",
          "written": true
        },
        {
          "unitIds": [
            "S04-U02"
          ],
          "text": "Resolve: اكتبه في صورة تانية.",
          "written": true
        },
        {
          "unitIds": [
            "S04-U03"
          ],
          "text": "الكسر: فوق $x + 1$، وتحت $x² − 3x + 2$.",
          "written": true
        },
        {
          "unitIds": [
            "S04-U04"
          ],
          "text": "into partial fractions: الصورة المطلوبة كسور جزئية. يعني: فكّك الكسر لكسور أبسط.",
          "written": true
        }
      ]
    },
    {
      "id": "S05",
      "title": "شرح 5: مثال من الكتاب ونصيحة",
      "clipId": "N05",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S05",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-exam-english"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S05-U01"
          ],
          "text": "من الكتاب: Find the partial fraction representations of $(5x + 1)/(x² − x − 12)$.",
          "written": true
        },
        {
          "unitIds": [
            "S05-U02"
          ],
          "text": "Find = طلّع، representations = الصورة. نفس الطلب: فكّك الكسر.",
          "written": true
        },
        {
          "unitIds": [
            "S05-U03"
          ],
          "text": "النصيحة: الفعل الأول، بعدين الرموز، بعدين الشروط. وكلمة مش عارفها؟ الفعل والرموز غالبًا كفاية.",
          "written": true
        }
      ]
    },
