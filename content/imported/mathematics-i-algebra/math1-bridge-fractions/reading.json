    {
      "id": "S07",
      "title": "خلاصة: الكسور",
      "clipId": "N07",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S07",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-fractions"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S07-U01"
          ],
          "text": "الكسر = بسط على مقام: المقام حجم الحتة، والبسط عدد الحتت.",
          "written": true
        },
        {
          "unitIds": [
            "S07-U02"
          ],
          "text": "نضرب فوق وتحت في نفس الرقم والقيمة ما تتغيرش.",
          "written": true
        },
        {
          "unitIds": [
            "S07-U03"
          ],
          "text": "عشان نجمع أو نطرح: نوحّد المقامات الأول. والمقام عمره ما يبقى صفر.",
          "written": true
        },
        {
          "unitIds": [
            "S07-U04"
          ],
          "text": "ورجوع الكسر لكسور أبسط = Partial Fractions. الدرس الجاي: حروف مكان الأرقام.",
          "written": true
        }
      ]
    }
  ],
  "glossary": [
    {
      "term": "Fraction",
      "meaning": "كسر: بسط على مقام"
    },
    {
      "term": "Numerator",
      "meaning": "البسط: عدد الحتت اللي معاك"
    },
    {
      "term": "Denominator",
      "meaning": "المقام: الحاجة اتقسمت كام حتة متساوية"
    },
    {
      "term": "Common Denominator",
      "meaning": "مقام مشترك بيخلي الحتت كلها بنفس الحجم"
    }
  ]
