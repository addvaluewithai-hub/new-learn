          "steps": [
            {
              "unitIds": [
                "F01-UEN"
              ],
              "text": "$1/3 + 1/4 = 4/12 + 3/12 = 7/12$.",
              "written": true
            },
            {
              "unitIds": [
                "F01-U1",
                "F01-UAR"
              ],
              "text": "المقام المشترك 12، لأن $3 × 4 = 12$.",
              "written": true
            },
            {
              "unitIds": [
                "F01-U2"
              ],
              "text": "$1/3 = 4/12$ و $1/4 = 3/12$، والمجموع $7/12$.",
              "written": true
            },
            {
              "unitIds": [
                "F01-U3"
              ],
              "text": "لو طلع $2/7$، يبقى جمعت فوق مع فوق وتحت مع تحت. الحتت لازم تبقى نفس الحجم الأول.",
              "written": true
            }
          ],
          "visual": {
