  "scenes": [
    {
      "id": "S01",
      "title": "شرح 1: مستطيل بيضرب قوسين",
      "clipId": "N01",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S01",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S01-U01"
          ],
          "text": "فكينا قوس واحد. النهارده: قوسين في بعض، وبعدين العكس، وده أهم مهارة في الكسور الجزئية.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U02"
          ],
          "text": "مستطيل عرضه $x + 2$ وطوله $x + 3$. مساحته $(x + 2)(x + 3)$.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U03"
          ],
          "text": "نقسمه 4 حتت: $x²$ و $3x$ و $2x$ و $6$.",
          "written": true
        },
        {
          "unitIds": [
            "S01-U04"
          ],
          "text": "المجموع: $x² + 5x + 6$.",
          "written": true
        }
      ]
    },
    {
      "id": "S02",
      "title": "شرح 2: كل حد في كل حد",
      "clipId": "N02",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S02",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S02-U01"
          ],
          "text": "من غير رسم: كل حد في الأول × كل حد في التاني: 4 حدود، وبعدين نجمع المتشابه.",
          "written": true
        },
        {
          "unitIds": [
            "S02-U02"
          ],
          "text": "مع السالب: $(x − 1)(x − 2) = x² − 2x − x + 2$.",
          "written": true
        },
        {
          "unitIds": [
            "S02-U03"
          ],
          "text": "يعني $x² − 3x + 2$، وده مقام أول مثال في الكتاب.",
          "written": true
        }
      ]
    },
    {
      "id": "S03",
      "title": "شرح 3: النمط… والعكس",
      "clipId": "N03",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S03",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S03-U01"
          ],
          "text": "في $(x + 2)(x + 3)$: الرقمين 2 و 3، مجموعهم 5 = الرقم قدام $x$، وحاصل ضربهم 6 = الثابت.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U02"
          ],
          "text": "وفي $(x − 1)(x − 2)$: $−1$ و $−2$، مجموعهم $−3$ وحاصل ضربهم $+2$. نفس النمط.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U03"
          ],
          "text": "نرجع بالعكس: $x² + 5x + 6$، دوّر على رقمين ضربهم 6 وجمعهم 5: هما 2 و 3.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U04"
          ],
          "text": "يبقى $(x + 2)(x + 3)$. العكس ده اسمه التحليل (Factorise)، وكل قوس اسمه عامل (Factor)، والضرب اسمه Expand.",
          "written": true
        },
        {
          "unitIds": [
            "S03-U05"
          ],
          "text": "الطريقة دي لما $x²$ يكون من غير رقم قدامه، وده اللي هنحتاجه دلوقتي.",
          "written": true
        }
      ]
    },
    {
      "id": "S04",
      "title": "شرح 4: مثال بالسالب من الكتاب",
      "clipId": "N04",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S04",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S04-U01"
          ],
          "text": "من الكتاب: $x² − x − 12$. رقمين ضربهم $−12$ وجمعهم $−1$.",
          "written": true
        },
        {
          "unitIds": [
            "S04-U02"
          ],
          "text": "الضرب سالب، يبقى واحد موجب وواحد سالب: $−4$ و $+3$.",
          "written": true
        },
        {
          "unitIds": [
            "S04-U03"
          ],
          "text": "يبقى $x² − x − 12 = (x − 4)(x + 3)$. واتأكد دايمًا بالفرد.",
          "written": true
        }
      ]
    },
    {
      "id": "S05",
      "title": "شرح 5: العامل المشترك",
      "clipId": "N05",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S05",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S05-U01"
          ],
          "text": "أحيانًا فيه حاجة مشتركة: $x³ + x² − 6x$ كل حدوده فيها $x$، فنطلعها: $x(x² + x − 6)$. ده عامل مشترك.",
          "written": true
        },
        {
          "unitIds": [
            "S05-U02"
          ],
          "text": "وبعدين نحلل اللي جوه: 3 و $−2$. يبقى $x(x − 2)(x + 3)$.",
          "written": true
        }
      ]
    },
    {
      "id": "S06",
      "title": "شرح 6: مش كل تعبير بيتحلل",
      "clipId": "N06",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S06",
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S06-U01"
          ],
          "text": "مش كل تعبير بيتحلل: $x² + 1$ محتاج رقمين ضربهم 1 وجمعهم 0.",
          "written": true
        },
        {
          "unitIds": [
            "S06-U02"
          ],
          "text": "1 و 1 جمعهم 2، و $−1$ و $−1$ جمعهم $−2$. مفيش رقمين ينفعوا.",
          "written": true
        },
        {
          "unitIds": [
            "S06-U03"
          ],
          "text": "يبقى ما بيتحللش، وفي الكسور الجزئية ليه معاملة خاصة.",
          "written": true
        }
      ]
    },
    {
      "id": "S07",
      "title": "سؤال 1: حلّل",
      "clipId": "N07",
      "visual": {
        "renderer": "math-board",
        "params": {
          "scene": "S07",
          "questionId": "Q01",
          "hideAnswerUntilAttempt": true,
          "assetBase": "/lesson-assets/mathematics-i-algebra/math1-bridge-factorising"
        }
      },
      "steps": [
        {
          "unitIds": [
            "S07-UEN"
          ],
          "text": "Factorise $x² + 7x + 10$.",
          "written": true
        },
        {
          "unitIds": [
            "S07-UAR"
          ],
          "text": "حلّل لقوسين: رقمين ضربهم 10 وجمعهم 7. وبعدين افرد عشان تتأكد.",
          "written": true
        }
      ],
      "question": {
        "id": "Q01",
        "english": "Factorise $x² + 7x + 10$.",
        "arabic": "حلّل لقوسين: رقمين ضربهم 10 وجمعهم 7. وبعدين افرد عشان تتأكد.",
        "attempt": "written",
        "options": [],
        "answer": {
